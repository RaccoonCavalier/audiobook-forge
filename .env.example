# ============ 复制为 .env 后填写 ============

# ---- 运行 ----
ABF_DATA_DIR=./data
# 成品输出目录：整本 mp3/m4b 和按章文件都写到这里
# Docker 里设成 /output 并把宿主机目录挂上去即可
ABF_OUTPUT_DIR=./output
ABF_HOST=127.0.0.1
ABF_PORT=8848

# ---- LLM（负责分章、断句、说话人识别、角色音色、朗读指令）----
# 任何 OpenAI 兼容接口都行：DeepSeek / 通义 / MiMo / Ollama / vLLM
ABF_LLM_BASE_URL=https://api.deepseek.com/v1
ABF_LLM_API_KEY=
ABF_LLM_MODEL=deepseek-chat
ABF_LLM_CONCURRENCY=3

# 没有 LLM key 时可关掉，退回纯规则分拣（质量下降但能跑）
ABF_LLM_ENABLED=true

# ---- TTS 提供商：mock / mimo / xfyun / openai ----
ABF_TTS_PROVIDER=mock

# 小米 MiMo TTS（OpenAI 兼容；注册：https://platform.xiaomimimo.com）
ABF_MIMO_API_KEY=
ABF_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
ABF_MIMO_MODEL=mimo-v2.5-tts
ABF_MIMO_DEFAULT_VOICE=冰糖

# 科大讯飞 超拟人语音合成
ABF_XFYUN_APP_ID=
ABF_XFYUN_API_KEY=
ABF_XFYUN_API_SECRET=
ABF_XFYUN_VOICE=x4_yezi

# OpenAI 兼容 / 本地自建 TTS（POST {base_url}/audio/speech）
# 适用于 openedai-speech、Kokoro-FastAPI、LocalAI、GPT-SoVITS-OpenAI-API 等
ABF_OPENAI_TTS_BASE_URL=http://127.0.0.1:8000/v1
ABF_OPENAI_TTS_API_KEY=
ABF_OPENAI_TTS_MODEL=tts-1
ABF_OPENAI_TTS_VOICE=alloy

# ---- 合成参数 ----
ABF_TTS_CONCURRENCY=4
ABF_TTS_RETRIES=3
# 单段建议字数（太长会被服务端截断，太短则韵律差）
ABF_SEGMENT_MIN_CHARS=12
ABF_SEGMENT_MAX_CHARS=120
ABF_AUDIO_BITRATE=64k
ABF_AUDIO_SAMPLE_RATE=44100
# 三档停顿（毫秒）：同一段被切开的分片 / 段落之间 / 章节之间
# 觉得段落之间太赶，先把 ABF_BLOCK_GAP_MS 调到 800~1200
ABF_INTRA_BLOCK_GAP_MS=200
ABF_BLOCK_GAP_MS=700
ABF_CHAPTER_GAP_MS=1600
